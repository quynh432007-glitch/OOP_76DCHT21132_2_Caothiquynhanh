#include <iostream>
#include <iomanip>
#include <string>
#include <vector>

using namespace std;

// ================= LOP MON HOC =================
class MonHoc {
protected:
    string tenMon;
    float diemCC;
    float diemKT;
    float diemDT;

public:
    // Ham tao khong doi
    MonHoc() {
        tenMon = "";
        diemCC = 0;
        diemKT = 0;
        diemDT = 0;
    }

    // Ham tao co doi
    MonHoc(string ten, float cc, float kt, float dt) {
        tenMon = ten;
        diemCC = cc;
        diemKT = kt;
        diemDT = dt;
    }

    // Ham nhap
    void nhapMonHoc() {
        cout << "Nhap ten mon hoc: ";
        getline(cin, tenMon);

        cout << "Nhap diem chuyen can: ";
        cin >> diemCC;

        cout << "Nhap diem kiem tra: ";
        cin >> diemKT;

        cout << "Nhap diem thi: ";
        cin >> diemDT;

        cin.ignore();
    }

    // Ham tinh diem hoc phan
    float tinhDiemHocPhan() const {
        return diemCC * 0.1 + diemKT * 0.2 + diemDT * 0.7;
    }
};


// ================= LOP SINH VIEN =================
class SinhVien : public MonHoc {
private:
    string hoTen;
    string lop;
    string maSV;

public:
    // Ham tao khong doi
    SinhVien() : MonHoc() {
        hoTen = "";
        lop = "";
        maSV = "";
    }

    // Ham tao co doi
    SinhVien(string tenMon, float cc, float kt, float dt,
             string ht, string l, string ma)
        : MonHoc(tenMon, cc, kt, dt) {
        hoTen = ht;
        lop = l;
        maSV = ma;
    }

    // Ham nhap
    void nhap() {
        cout << "Nhap ma sinh vien: ";
        getline(cin, maSV);

        cout << "Nhap ho ten: ";
        getline(cin, hoTen);

        cout << "Nhap lop: ";
        getline(cin, lop);

        nhapMonHoc();
    }

    // Ham xuat
    void xuat() const {
        cout << left
             << setw(15) << maSV
             << setw(25) << hoTen
             << setw(15) << lop
             << setw(15) << tenMon
             << setw(10) << diemCC
             << setw(10) << diemKT
             << setw(10) << diemDT
             << setw(10) << tinhDiemHocPhan()
             << endl;
    }

    // Kiem tra sinh vien bi cam thi
    bool biCamThi() const {
        return diemCC < 5 || diemKT == 0;
    }
};


// ================= HAM MAIN =================
int main() {
    int n;

    cout << "Nhap so sinh vien: ";
    cin >> n;
    cin.ignore();

    vector<SinhVien> ds;

    // Nhap n sinh vien
    for (int i = 0; i < n; i++) {
        cout << "\n========== SINH VIEN " << i + 1 << " ==========\n";

        SinhVien sv;
        sv.nhap();

        ds.push_back(sv);
    }

    // Xuat sinh vien bi cam thi
    cout << "\n\nDANH SACH SINH VIEN BI CAM THI\n";

    cout << left
         << setw(15) << "Ma SV"
         << setw(25) << "Ho ten"
         << setw(15) << "Lop"
         << setw(15) << "Mon hoc"
         << setw(10) << "CC"
         << setw(10) << "KT"
         << setw(10) << "DT"
         << setw(10) << "DHP"
         << endl;

    cout << string(110, '-') << endl;

    for (int i = 0; i < n; i++) {
        if (ds[i].biCamThi()) {
            ds[i].xuat();
        }
    }

    return 0;
}
